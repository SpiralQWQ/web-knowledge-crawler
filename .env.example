# 环境变量（全部可选，缺省时读取 config/collector.yaml）
# 复制为 .env 后需 pip install python-dotenv 才会被自动加载。
# ⚠️ 禁止在此模板写入个人绝对路径（P3：防分享/入库泄露用户名与盘符布局），一律用 <占位符>。

# 仓库根目录（数据/知识库/temp/logs 都建在这里）
KC_BASE=

# Crawl4AI 环境 Python 解释器
CRAWL4AI_PY=<YOUR_CRAWL4AI_VENV>/Scripts/python.exe

# 抖音下载器（jiji262 douyin-downloader）
DD_DL_SRC=<YOUR_DOUYIN_DOWNLOADER_SRC>
DD_DL_PY=<YOUR_DOUYIN_DOWNLOADER_VENV>/Scripts/python.exe

# yt-dlp 可执行文件（B站/YouTube）
DD_YTDLP=<YOUR_YTDLP_EXE>

# ffmpeg/ffprobe（可选，暂未使用）
FFMPEG=<YOUR_FFMPEG_EXE>

# Cookie 集中配置
# B站/YouTube → yt-dlp --cookies-from-browser（chrome/edge/firefox）；默认 edge
KC_COOKIE_BROWSER=edge
# 或 Netscape 格式 cookie 文件路径（优先于 browser）；可用 app/export_cookies.py 生成
KC_COOKIES_FILE=
# 抖音 jiji262 config.yml（默认随 DD_DL_SRC，一般无需设置）
KC_DOUYIN_CONFIG=
# 需登录态的域名（逗号分隔，覆盖 collector.yaml cookies.domains），如 bilibili.com,youtube.com,docs.google.com
KC_COOKIE_DOMAINS=
# 浏览器非默认 profile（如 Edge「工作」Profile 1）→ yt-dlp --cookies-from-browser edge:Profile 1
# 或 app/export_cookies.py --profile 用；不设则用默认 profile
KC_COOKIE_PROFILE=
# 浏览器运行中（profile 锁）时是否允许匿名下载（需登录的视频会失败）；1=true，默认拒绝
KC_ALLOW_ANONYMOUS=

# 代理（可选）
HTTP_PROXY=
HTTPS_PROXY=

# GitHub API 令牌（可选，解除仓库搜索限流 60→5000 次/时）
GH_TOKEN=<YOUR_GITHUB_TOKEN>
